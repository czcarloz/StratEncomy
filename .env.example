# =============================================================
# Copy this file to .env and fill in the real values.
# NEVER commit the actual .env file to git.
# =============================================================

# --- Postgres ---
POSTGRES_USER=stratencomy
POSTGRES_PASSWORD=change_to_strong_password
POSTGRES_DB=stratencomy

# --- pgAdmin ---
PGADMIN_EMAIL=admin@stratencomy.com
PGADMIN_PASSWORD=change_to_strong_password

# --- Backend ---
DATABASE_URL=postgresql+asyncpg://stratencomy:change_to_strong_password@localhost:5432/stratencomy
SECRET_KEY=generate_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ENVIRONMENT=development
DEBUG=true

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
